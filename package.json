{
  "name": "vulnsweep",
  "version": "1.0.3",
  "description": "Automated dependency vulnerability orchestrator for bulk npm security updates across multiple repositories",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build": "cross-env NODE_ENV=production vite build && node build-main.js && electron-builder",
    "build_com": "cross-env COMMERCIAL_BUILD=true npm run build",
    "build_license": "node scripts/generate-license.js",
    "build:main": "node build-main.js",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
    "format-check": "prettier --check \"src/**/*.{js,jsx,css,html}\"",
    "prepare": "husky"
  },
  "keywords": [
    "electron",
    "security",
    "npm",
    "vulnerabilities",
    "automation",
    "npm-audit",
    "dependency-management",
    "vulnerability-scanner",
    "bulk-operations",
    "git-automation",
    "devops",
    "security-audit"
  ],
  "author": "VulnSweep Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vulnsweep.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vulnsweep/issues"
  },
  "homepage": "https://github.com/yourusername/vulnsweep#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "babel-jest": "^30.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "41.3.0",
    "electron-builder": "26.8.1",
    "esbuild": "0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.33",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.1",
    "terser": "^5.27.0",
    "vite": "8.0.10",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^9.2.0",
    "lucide-react": "^1.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "semver": "^7.6.0",
    "sludge-crypt": "^1.0.3",
    "systeminformation": "^5.31.5"
  },
  "build": {
    "appId": "com.vulnsweep.app",
    "productName": "VulnSweep",
    "icon": "assets/mini_logo.png",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-main/**/*",
      "dist-renderer/**/*",
      "assets/*"
    ],
    "win": {
      "icon": "assets/mini_logo.png",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "assets/mini_logo.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "assets/mini_logo.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  }
}
