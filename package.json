{
  "name": "vulnsweep",
  "version": "1.3.8",
  "description": "Automated dependency vulnerability orchestrator for bulk npm security updates across multiple repositories",
  "main": "dist-main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "cross-env NODE_ENV=production vite build && node build-renderer-obfuscate.js",
    "build": "npm run build:renderer && cross-env NODE_ENV=production node build-main.js && electron-builder",
    "build:win": "npm run build:renderer && cross-env NODE_ENV=production node build-main.js && electron-builder --win",
    "build:mac": "npm run build:renderer && cross-env NODE_ENV=production node build-main.js && electron-builder --mac",
    "build:linux": "npm run build:renderer && cross-env NODE_ENV=production node build-main.js && electron-builder --linux",
    "build_com": "cross-env COMMERCIAL_BUILD=true npm run build",
    "build:win:com": "cross-env COMMERCIAL_BUILD=true npm run build:renderer && cross-env COMMERCIAL_BUILD=true node build-main.js && cross-env COMMERCIAL_BUILD=true electron-builder --win",
    "build:mac:com": "cross-env COMMERCIAL_BUILD=true npm run build:renderer && cross-env COMMERCIAL_BUILD=true node build-main.js && cross-env COMMERCIAL_BUILD=true electron-builder --mac",
    "build:linux:com": "cross-env COMMERCIAL_BUILD=true npm run build:renderer && cross-env COMMERCIAL_BUILD=true node build-main.js && cross-env COMMERCIAL_BUILD=true electron-builder --linux",
    "build_license": "node scripts/generate-license.js",
    "build:main": "node build-main.js",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint src/**/*.{js,jsx}",
    "lint:fix": "eslint src/**/*.{js,jsx} --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,html}\"",
    "format-check": "prettier --check \"src/**/*.{js,jsx,css,html}\"",
    "prepare": "husky",
    "build:cli": "node build-cli.js",
    "cli": "node src/cli/index.js",
    "cli:dev": "node src/cli/index.js",
    "cli:prod": "node dist-cli/vulnsweep.js",
    "nuke": "node scripts/nuke-all-data.js",
    "build:cli:debug": "cross-env SKIP_OBFUSCATION=true node build-cli.js",
    "build:main:debug": "cross-env SKIP_OBFUSCATION=true NODE_ENV=production node build-main.js"
  },
  "bin": {
    "vulnsweep": "./src/cli/index.js"
  },
  "keywords": [
    "electron",
    "security",
    "npm",
    "vulnerabilities",
    "automation",
    "npm-audit",
    "dependency-management",
    "vulnerability-scanner",
    "bulk-operations",
    "git-automation",
    "devops",
    "security-audit"
  ],
  "author": "VulnSweep Contributors",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vulnsweep.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vulnsweep/issues"
  },
  "homepage": "https://github.com/yourusername/vulnsweep#readme",
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.2",
    "babel-jest": "^30.3.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.6",
    "esbuild": "0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "javascript-obfuscator": "^5.4.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.3",
    "sludge-crypt": "^1.0.5",
    "tailwindcss": "^4.3.2",
    "terser": "^5.48.0",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@aptabase/electron": "0.3.1",
    "@tailwindcss/postcss": "^4.3.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "secure-ls": "^2.0.0",
    "semver": "^7.8.5",
    "systeminformation": "^5.31.11"
  },
  "build": {
    "appId": "com.vulnsweep.app",
    "productName": "VulnSweep",
    "icon": "assets/logo.png",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true,
      "enableCookieEncryption": true
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-main/**/*",
      "!dist-main/**/*.map",
      "dist-renderer/**/*",
      "!dist-renderer/**/*.map",
      "assets/*"
    ],
    "win": {
      "icon": "assets/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/mac/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "category": "Development",
      "icon": "assets/logo.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "VulnSweep <crazyprints4u@gmail.com>",
      "vendor": "VulnSweep",
      "synopsis": "Node.js vulnerability scanner",
      "description": "A desktop application for scanning and fixing vulnerabilities in Node.js projects"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,html,json,md}": "prettier --write"
  },
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@babel/core": "7.29.7",
    "brace-expansion": "5.0.7",
    "cacheable-request": "10.2.7",
    "axios": "1.18.1",
    "dompurify": "3.4.11",
    "form-data": "4.0.6",
    "js-yaml": "3.15.0",
    "shell-quote": "1.9.0",
    "tmp": "0.2.7",
    "undici": "6.27.0",
    "ws": "8.21.0"
  },
  "allowScripts": {
    "core-js@3.49.0": true,
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
