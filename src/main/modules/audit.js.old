/**
 * VulnSweep - Audit and Remediation Engine
 *
 * Core intelligence module that analyzes npm audit output, determines fix strategies,
 * and generates package.json modifications to resolve security vulnerabilities.
 */

const { exec } = require('child_process');
const fs = require('fs').promises;
const path = require('path');
const { promisify } = require('util');
const semver = require('semver');
const RegistryCache = require('../utils/registry-cache');
const { createSuccess, createError } = require('../utils/result');
const git = require('./git');
const { CACHE_CONFIG, API_CONFIG } = require('../config/constants');

const execAsync = promisify(exec);

// Create singleton cache instance for npm registry responses
// TTL configured in constants to balance freshness and performance
const registryCache = new RegistryCache(CACHE_CONFIG.TTL_MS);

/**
 * Execute npm install in the project directory
 * @param {string} projectPath - Absolute path to the project
 * @returns {Promise<Object>} { success: boolean, stdout: string, stderr: string }
 */
async function runNpmInstall(projectPath) {
  try {
    console.log(`[audit] Running npm install in: ${projectPath}`);

    const { stdout, stderr } = await execAsync('npm install', {
      cwd: projectPath,
      encoding: 'utf8',
      maxBuffer: API_CONFIG.MAX_BUFFER_BYTES,
    });

    return createSuccess({
      stdout: stdout || '',
      stderr: stderr || '',
    });
  } catch (error) {
    console.error(`[audit] npm install failed: ${error.message}`);
    return createError(error.stderr?.toString() || error.message, {
      stdout: error.stdout?.toString() || '',
      stderr: error.stderr?.toString() || error.message,
    });
  }
}

/**
 * Execute npm audit and parse JSON output
 * @param {string} projectPath - Absolute path to the project
 * @returns {Promise<Object>} { success: boolean, auditData: object, rawOutput: string }
 */
async function runNpmAudit(projectPath) {
  try {
    console.log(`[audit] Running npm audit in: ${projectPath}`);

    const { stdout } = await execAsync('npm audit --json', {
      cwd: projectPath,
      encoding: 'utf8',
      maxBuffer: API_CONFIG.MAX_BUFFER_BYTES,
    });

    const auditData = JSON.parse(stdout);

    return createSuccess({
      auditData,
      rawOutput: stdout,
    });
  } catch (error) {
    // npm audit returns non-zero exit code when vulnerabilities are found
    // So we need to check if we got valid JSON output
    const output = error.stdout?.toString() || '';

    if (output) {
      try {
        const auditData = JSON.parse(output);
        return createSuccess({
          auditData,
          rawOutput: output,
        });
      } catch (parseError) {
        console.error(`[audit] Failed to parse npm audit output: ${parseError.message}`);
        return createError(parseError.message, {
          auditData: null,
          rawOutput: output,
        });
      }
    }

    console.error(`[audit] npm audit failed: ${error.message}`);
    return createError(error.message, {
      auditData: null,
      rawOutput: '',
    });
  }
}

/**
 * Internal function to fetch latest version directly from npm registry (bypasses cache)
 * @param {string} packageName - Package name
 * @returns {Promise<string|null>} - Latest version or null if fetch fails
 */
async function fetchLatestSafeVersionDirect(packageName) {
  try {
    // Use npm view to get latest version
    const { stdout } = await execAsync(`npm view ${packageName} version`, {
      encoding: 'utf8',
      timeout: API_CONFIG.NPM_COMMAND_TIMEOUT_MS,
      maxBuffer: API_CONFIG.MAX_BUFFER_BYTES,
    });
    const version = stdout.trim();
    return version;
  } catch (error) {
    console.warn(`[audit] Failed to fetch latest version for ${packageName}: ${error.message}`);
    return null;
  }
}

/**
 * Fetch latest version of a package from npm registry (with caching)
 * @param {string} packageName - Package name
 * @returns {Promise<string|null>} - Latest version or null if fetch fails
 */
async function fetchLatestSafeVersion(packageName) {
  const result = await registryCache.getLatestVersion(packageName, fetchLatestSafeVersionDirect);
  if (!result.success) {
    return null;
  }
  return result.content;
}

/**
 * Internal function to fetch all versions directly from npm registry (bypasses cache)
 * @param {string} packageName - Package name
 * @returns {Promise<string[]|null>} - Array of version strings or null if fetch fails
 */
async function fetchAllVersionsDirect(packageName) {
  try {
    const { stdout } = await execAsync(`npm view ${packageName} versions --json`, {
      encoding: 'utf8',
      timeout: API_CONFIG.NPM_COMMAND_TIMEOUT_MS,
      maxBuffer: API_CONFIG.MAX_BUFFER_BYTES,
    });
    const versions = JSON.parse(stdout);
    return versions;
  } catch (error) {
    console.warn(`[audit] Failed to fetch versions for ${packageName}: ${error.message}`);
    return null;
  }
}

/**
 * Fetch all available versions of a package from npm registry (with caching)
 * @param {string} packageName - Package name
 * @returns {Promise<string[]|null>} - Array of version strings or null if fetch fails
 */
async function fetchAllVersions(packageName) {
  const result = await registryCache.getAllVersions(packageName, fetchAllVersionsDirect);
  if (!result.success) {
    return null;
  }
  return result.content;
}

/**
 * Read package-lock.json and extract installed version of a package
 * @param {string} projectPath - Absolute path to the project
 * @param {string} packageName - Package name
 * @returns {Promise<string|null>} - Installed version or null if not found
 */
async function getInstalledVersionFromLockfile(projectPath, packageName) {
  try {
    const lockfilePath = path.join(projectPath, 'package-lock.json');

    // Check if file exists using fs.access()
    try {
      await fs.access(lockfilePath);
    } catch {
      return null;
    }

    const lockfileContent = await fs.readFile(lockfilePath, 'utf8');
    const lockfile = JSON.parse(lockfileContent);

    // npm v7+ lockfile format
    if (lockfile.packages) {
      // Check in packages section
      for (const [pkgPath, pkgInfo] of Object.entries(lockfile.packages)) {
        if (
          pkgPath.endsWith(`/node_modules/${packageName}`) ||
          pkgPath === `node_modules/${packageName}`
        ) {
          return pkgInfo.version;
        }
      }
    }

    // npm v6 lockfile format
    if (lockfile.dependencies && lockfile.dependencies[packageName]) {
      return lockfile.dependencies[packageName].version;
    }

    return null;
  } catch (error) {
    console.warn(`[audit] Failed to read package-lock.json: ${error.message}`);
    return null;
  }
}

/**
 * Find a safe version that's not in the vulnerable range
 * @param {string} packageName - Package name
 * @param {string} range - Vulnerable version range
 * @param {string} currentVersion - Current installed version (optional)
 * @returns {Promise<string|null>} - Safe version or null
 */
async function findSafeVersionOutsideRange(packageName, range, currentVersion = null) {
  try {
    // Check if current version is already safe (outside vulnerable range)
    if (currentVersion) {
      try {
        const cleanCurrent = semver.coerce(currentVersion);
        if (cleanCurrent && !semver.satisfies(cleanCurrent.version, range)) {
          return null; // No fix needed
        }
      } catch (error) {
        console.warn(
          `[audit] Could not validate current version ${currentVersion}: ${error.message}`
        );
      }
    }

    const allVersions = await fetchAllVersions(packageName);
    if (!allVersions || allVersions.length === 0) {
      return null;
    }

    // Sort versions in descending order (latest first)
    const sortedVersions = allVersions.sort((a, b) => {
      try {
        return semver.rcompare(a, b);
      } catch {
        return 0;
      }
    });

    // Find the first version that doesn't satisfy the vulnerable range AND is >= currentVersion
    for (const version of sortedVersions) {
      try {
        const isOutsideRange = !semver.satisfies(version, range);

        // Check if this version is >= currentVersion
        let isUpgrade = true;
        if (currentVersion) {
          const cleanCurrent = semver.coerce(currentVersion);
          const cleanCandidate = semver.coerce(version);
          if (cleanCurrent && cleanCandidate) {
            isUpgrade = semver.gte(cleanCandidate.version, cleanCurrent.version);
          }
        }

        if (isOutsideRange && isUpgrade) {
          return `^${version}`;
        }
      } catch {
        // Skip invalid versions
        continue;
      }
    }

    return null;
  } catch (error) {
    console.warn(`[audit] Error finding safe version for ${packageName}: ${error.message}`);
    return null;
  }
}

/**
 * Parse vulnerability range and determine safe version
 * @param {string} packageName - Package name
 * @param {string} range - Version range from vulnerability (e.g., "< 6.14.0", "<= 1.1.0", "5.0.0 - 5.2.1")
 * @param {string} currentVersion - Current installed version (optional)
 * @param {string} projectPath - Project path for lockfile lookup (optional)
 * @returns {Promise<string|null>} - Safe version to use, or null if cannot determine
 */
async function determineSafeVersion(packageName, range, currentVersion = null, projectPath = null) {
  // Pattern: >= X.Y.Z (all versions from X.Y.Z onwards are vulnerable - NO FIX)
  const greaterThanEqualMatch = range.match(/^>=\s*(\d+\.\d+\.\d+)$/);
  if (greaterThanEqualMatch) {
    return null; // No safe version available
  }

  // Pattern 1: < X.Y.Z (less than)
  const lessThanMatch = range.match(/^<\s*(\d+\.\d+\.\d+)$/);

  if (lessThanMatch) {
    const version = lessThanMatch[1];
    const safeVersion = `^${version}`;

    // Validate that the recommended version is >= currentVersion
    if (currentVersion) {
      try {
        const cleanCurrent = semver.coerce(currentVersion);
        const cleanRecommended = semver.coerce(version);
        if (cleanCurrent && cleanRecommended) {
          if (semver.lt(cleanRecommended.version, cleanCurrent.version)) {
            return null;
          }
        }
      } catch (error) {
        console.warn(`[audit] Could not compare versions: ${error.message}`);
      }
    }

    return safeVersion;
  }

  // Pattern 2: <= X.Y.Z (less than or equal)
  const lessThanEqualMatch = range.match(/^<=\s*(\d+\.\d+\.\d+)$/);
  if (lessThanEqualMatch) {
    const latestVersion = await fetchLatestSafeVersion(packageName);

    // Validate that the latest version is >= currentVersion
    if (latestVersion && currentVersion) {
      try {
        const cleanCurrent = semver.coerce(currentVersion);
        const cleanLatest = semver.coerce(latestVersion);
        if (cleanCurrent && cleanLatest) {
          if (semver.lt(cleanLatest.version, cleanCurrent.version)) {
            return null;
          }
        }
      } catch (error) {
        console.warn(`[audit] Could not compare versions: ${error.message}`);
      }
    }

    return latestVersion;
  }

  // Pattern 3: X.Y.Z - A.B.C (range pattern)
  const rangeMatch = range.match(/\d+\.\d+\.\d+\s*-\s*\d+\.\d+\.\d+/);
  if (rangeMatch) {
    const latestVersion = await fetchLatestSafeVersion(packageName);

    // Validate that the latest version is >= currentVersion
    if (latestVersion && currentVersion) {
      try {
        const cleanCurrent = semver.coerce(currentVersion);
        const cleanLatest = semver.coerce(latestVersion);
        if (cleanCurrent && cleanLatest) {
          if (semver.lt(cleanLatest.version, cleanCurrent.version)) {
            return null;
          }
        }
      } catch (error) {
        console.warn(`[audit] Could not compare versions: ${error.message}`);
      }
    }

    return latestVersion;
  }

  // Pattern 4: Complex ranges with || or multiple conditions
  // Examples: ">=5.0.0 <5.2.3 || <4.12.3", ">1.0.0 <2.0.0 || >3.0.0"
  if (range.includes('||') || (range.includes('>') && range.includes('<'))) {
    // Use provided currentVersion or get from package-lock.json
    let installedVersion = currentVersion;
    if (!installedVersion && projectPath) {
      installedVersion = await getInstalledVersionFromLockfile(projectPath, packageName);
    }

    // Try to find a safe version outside the vulnerable range
    return await findSafeVersionOutsideRange(packageName, range, installedVersion);
  }

  return null;
}

/**
 * Parse npm audit JSON into structured vulnerability array
 * @param {Object} auditData - npm audit JSON output
 * @returns {Array} Array of vulnerability objects
 */
async function parseVulnerabilities(auditData, projectPath) {
  const vulnerabilities = [];

  if (!auditData || !auditData.vulnerabilities) {
    return vulnerabilities;
  }

  for (const [pkgName, vulnData] of Object.entries(auditData.vulnerabilities)) {
    // Extract vulnerability details
    const isDirect = vulnData.isDirect || false;
    const severity = vulnData.severity || 'unknown';
    const vulnerableRange = vulnData.range || '';

    // Get actual installed version from package-lock.json
    const installedVersion =
      (await getInstalledVersionFromLockfile(projectPath, pkgName)) || 'unknown';

    // Get patched version from fixAvailable
    let patchedVersion = null;
    if (vulnData.fixAvailable && typeof vulnData.fixAvailable === 'object') {
      patchedVersion = vulnData.fixAvailable.version;
    }

    // Extract via chain (dependency path)
    const via = Array.isArray(vulnData.via) ? vulnData.via : [];

    // Extract vulnerability titles and URLs from via if available
    let title = `Vulnerability in ${pkgName}`;
    let url = '';
    let cwe = [];

    for (const viaItem of via) {
      if (typeof viaItem === 'object') {
        if (viaItem.title) title = viaItem.title;
        if (viaItem.url) url = viaItem.url;
        if (viaItem.cwe) cwe = viaItem.cwe;
      }
    }

    vulnerabilities.push({
      package: pkgName,
      installedVersion,
      vulnerableRange,
      patchedVersion,
      severity,
      isDirect,
      title,
      url,
      cwe,
      via,
      fixAvailable: vulnData.fixAvailable,
    });
  }

  return vulnerabilities;
}

/**
 * Determine the appropriate fix strategy based on the PRD decision tree
 * @param {Object} vulnerability - Vulnerability object
 * @param {Object} auditData - Full npm audit data for context
 * @returns {Promise<Object>} Strategy object
 */
async function determineFixStrategy(vulnerability, auditData) {
  const {
    package: pkgName,
    isDirect,
    fixAvailable,
    patchedVersion,
    installedVersion,
  } = vulnerability;

  // Scenario A: Direct Dependency (Minor/Patch Update)
  if (isDirect) {
    if (!fixAvailable) {
      return {
        type: 'NO_FIX',
        package: pkgName,
        currentVersion: installedVersion,
        targetVersion: null,
        riskLevel: 'N/A',
        reason: 'No fix available for direct dependency',
      };
    }

    let targetVersion;
    let isMajor = false;

    if (typeof fixAvailable === 'object' && fixAvailable.version) {
      // fixAvailable is an object with version info
      targetVersion = fixAvailable.version;
      isMajor = fixAvailable.isSemVerMajor || false;
    } else if (typeof fixAvailable === 'boolean' && fixAvailable === true) {
      // fixAvailable is just true, need to determine version from vulnerability range
      const vulnerabilityRange =
        vulnerability.vulnerableRange || auditData.vulnerabilities[pkgName]?.range;
      if (vulnerabilityRange) {
        targetVersion = await determineSafeVersion(
          pkgName,
          vulnerabilityRange,
          installedVersion,
          null
        );
      }

      if (!targetVersion) {
        // Could not determine a safe version
        targetVersion = await fetchLatestSafeVersion(pkgName);
      }

      if (!targetVersion) {
        return {
          type: 'NO_FIX',
          package: pkgName,
          currentVersion: installedVersion,
          targetVersion: null,
          riskLevel: 'N/A',
          reason: 'Could not determine safe version for direct dependency',
        };
      }
    } else if (typeof fixAvailable === 'string') {
      // fixAvailable is a version string
      targetVersion = fixAvailable;
    } else {
      // Unknown fixAvailable format
      return {
        type: 'NO_FIX',
        package: pkgName,
        currentVersion: installedVersion,
        targetVersion: null,
        riskLevel: 'N/A',
        reason: 'Invalid fix information for direct dependency',
      };
    }

    return {
      type: 'UPDATE_DIRECT',
      package: pkgName,
      currentVersion: installedVersion,
      targetVersion,
      riskLevel: isMajor ? 'HIGH' : 'LOW',
      reason: `Direct dependency can be updated to ${targetVersion}${isMajor ? ' (major version change)' : ''}`,
    };
  }

  // Scenario B & C: Transient Dependency
  // Check if a parent dependency update can resolve it
  const parentPackage = findParentPackage(pkgName, auditData);

  if (parentPackage && fixAvailable) {
    // Scenario B: Parent dependency can be updated
    const targetVersion = typeof fixAvailable === 'object' ? fixAvailable.version : fixAvailable;
    const isMajor = typeof fixAvailable === 'object' ? fixAvailable.isSemVerMajor : false;

    return {
      type: 'UPDATE_PARENT',
      package: pkgName,
      parentPackage,
      currentVersion: installedVersion,
      targetVersion,
      riskLevel: isMajor ? 'HIGH' : 'LOW',
      reason: `Updating parent dependency '${parentPackage}' to ${targetVersion} will resolve transient vulnerability`,
    };
  }

  // Scenario C: Deep root or no direct update available - use npm overrides
  // Try to determine safe version from the vulnerability range
  const vulnerabilityRange =
    vulnerability.vulnerableRange || auditData.vulnerabilities[pkgName]?.range;
  let targetVersion = patchedVersion;

  if (vulnerabilityRange) {
    // Pass installedVersion to prevent downgrades
    const safeVersion = await determineSafeVersion(
      pkgName,
      vulnerabilityRange,
      installedVersion,
      null
    );
    if (safeVersion) {
      targetVersion = safeVersion;
    } else {
      // No safe version could be determined (e.g., all versions vulnerable with >=X.Y.Z pattern)
      // Or the only safe version would be a downgrade
      return {
        type: 'NO_FIX',
        package: pkgName,
        currentVersion: installedVersion,
        targetVersion: null,
        riskLevel: 'N/A',
        reason:
          'No safe version available (all versions may be vulnerable or would require downgrade)',
      };
    }
  }

  if (!targetVersion) {
    // Fallback: no version could be determined
    return {
      type: 'NO_FIX',
      package: pkgName,
      currentVersion: installedVersion,
      targetVersion: null,
      riskLevel: 'N/A',
      reason: 'No target version available for transient dependency',
    };
  }

  // Determine risk level based on version difference
  let riskLevel = 'LOW';
  try {
    const current = semver.coerce(installedVersion);
    const target = semver.coerce(targetVersion);

    if (current && target) {
      const diff = semver.diff(current.version, target.version);
      if (diff === 'major') {
        riskLevel = 'HIGH';
      }
    }
  } catch (error) {
    console.warn(`[audit] Could not compare versions for ${pkgName}: ${error.message}`);
  }

  return {
    type: 'ADD_OVERRIDE',
    package: pkgName,
    currentVersion: installedVersion,
    targetVersion,
    riskLevel,
    reason: `Add override for ${pkgName} to version ${targetVersion} (deep transient dependency${riskLevel === 'HIGH' ? ', MAJOR update' : ''})`,
  };
}

/**
 * Find the direct parent package for a transient dependency
 * @param {string} pkgName - Package name
 * @param {Object} auditData - npm audit data
 * @returns {string|null} Parent package name or null
 */
function findParentPackage(pkgName, auditData) {
  if (!auditData || !auditData.vulnerabilities) {
    return null;
  }

  const vulnData = auditData.vulnerabilities[pkgName];
  if (!vulnData || !Array.isArray(vulnData.via)) {
    return null;
  }

  // Find first direct dependency in the via chain
  for (const viaItem of vulnData.via) {
    if (typeof viaItem === 'string') {
      // Check if this package is direct
      const parentVuln = auditData.vulnerabilities[viaItem];
      if (parentVuln && parentVuln.isDirect) {
        return viaItem;
      }
    }
  }

  return null;
}

/**
 * Generate package.json changes based on fix strategies
 * @param {Array} strategies - Array of strategy objects
 * @param {Object} currentPackageJson - Current package.json object
 * @returns {Object} { modifiedPackageJson: object, changes: array }
 */
function generatePackageJsonChanges(strategies, currentPackageJson) {
  const modifiedPackageJson = JSON.parse(JSON.stringify(currentPackageJson));
  const changes = [];

  // Ensure dependencies and devDependencies exist
  if (!modifiedPackageJson.dependencies) {
    modifiedPackageJson.dependencies = {};
  }
  if (!modifiedPackageJson.devDependencies) {
    modifiedPackageJson.devDependencies = {};
  }

  for (const strategy of strategies) {
    if (strategy.type === 'NO_FIX') {
      continue; // Skip strategies with no fix
    }

    if (strategy.type === 'UPDATE_DIRECT') {
      // Update direct dependency version
      const { package: pkgName, targetVersion } = strategy;

      if (modifiedPackageJson.dependencies[pkgName]) {
        modifiedPackageJson.dependencies[pkgName] = targetVersion;
        changes.push({
          type: 'UPDATE_DIRECT',
          location: 'dependencies',
          package: pkgName,
          from: currentPackageJson.dependencies[pkgName],
          to: targetVersion,
        });
      } else if (modifiedPackageJson.devDependencies[pkgName]) {
        modifiedPackageJson.devDependencies[pkgName] = targetVersion;
        changes.push({
          type: 'UPDATE_DIRECT',
          location: 'devDependencies',
          package: pkgName,
          from: currentPackageJson.devDependencies[pkgName],
          to: targetVersion,
        });
      }
    } else if (strategy.type === 'UPDATE_PARENT') {
      // Update parent dependency version
      const { parentPackage, targetVersion } = strategy;

      if (modifiedPackageJson.dependencies[parentPackage]) {
        modifiedPackageJson.dependencies[parentPackage] = targetVersion;
        changes.push({
          type: 'UPDATE_PARENT',
          location: 'dependencies',
          package: parentPackage,
          from: currentPackageJson.dependencies[parentPackage],
          to: targetVersion,
        });
      } else if (modifiedPackageJson.devDependencies[parentPackage]) {
        modifiedPackageJson.devDependencies[parentPackage] = targetVersion;
        changes.push({
          type: 'UPDATE_PARENT',
          location: 'devDependencies',
          package: parentPackage,
          from: currentPackageJson.devDependencies[parentPackage],
          to: targetVersion,
        });
      }
    } else if (strategy.type === 'ADD_OVERRIDE') {
      // Add npm override (npm v8+)
      const { package: pkgName, targetVersion } = strategy;

      if (!modifiedPackageJson.overrides) {
        modifiedPackageJson.overrides = {};
      }

      modifiedPackageJson.overrides[pkgName] = targetVersion;
      changes.push({
        type: 'ADD_OVERRIDE',
        location: 'overrides',
        package: pkgName,
        to: targetVersion,
      });
    }
  }

  return { modifiedPackageJson, changes };
}

/**
 * Apply fixes to a project by modifying package.json and running npm install
 * @param {string} projectPath - Absolute path to the project
 * @param {Array} strategies - Array of strategy objects
 * @returns {Promise<Object>} { success: boolean, applied: array, resolved: array, remaining: array }
 */
async function applyFixes(projectPath, strategies) {
  try {
    console.log(`[audit] Applying fixes to: ${projectPath}`);

    // Read current package.json
    const packageJsonPath = path.join(projectPath, 'package.json');

    // Check if file exists using fs.access()
    try {
      await fs.access(packageJsonPath);
    } catch {
      return createError('package.json not found', {
        applied: [],
        resolved: [],
        remaining: [],
      });
    }

    const currentPackageJson = JSON.parse(await fs.readFile(packageJsonPath, 'utf8'));

    // Generate changes
    const { modifiedPackageJson, changes } = generatePackageJsonChanges(
      strategies,
      currentPackageJson
    );

    if (changes.length === 0) {
      return createSuccess({
        applied: [],
        resolved: [],
        remaining: strategies.filter((s) => s.type === 'NO_FIX'),
      });
    }

    // Backup original package.json
    const backupPath = path.join(projectPath, 'package.json.backup');
    await fs.writeFile(backupPath, JSON.stringify(currentPackageJson, null, 2));
    console.log(`[audit] Backed up package.json to ${backupPath}`);

    // Write modified package.json
    await fs.writeFile(packageJsonPath, JSON.stringify(modifiedPackageJson, null, 2));
    console.log('[audit] Updated package.json');

    // Run npm install to apply changes
    const installResult = await runNpmInstall(projectPath);
    if (!installResult.success) {
      // Restore backup on failure
      await fs.writeFile(packageJsonPath, JSON.stringify(currentPackageJson, null, 2));
      console.error('[audit] npm install failed, restored backup');
      return createError(installResult.error, {
        applied: changes,
        resolved: [],
        remaining: strategies,
      });
    }

    // Run npm audit again to verify fixes
    const auditResult = await runNpmAudit(projectPath);
    if (!auditResult.success) {
      console.warn('[audit] Could not verify fixes with npm audit');
      return createSuccess({
        applied: changes,
        resolved: [],
        remaining: [],
      });
    }

    // Compare vulnerabilities before and after
    const afterVulns = await parseVulnerabilities(auditResult.content.auditData, projectPath);
    const resolved = changes.map((c) => c.package);
    const remaining = afterVulns.filter((v) => !resolved.includes(v.package));

    console.log(
      `[audit] Applied ${changes.length} fixes, resolved ${resolved.length} vulnerabilities, ${remaining.length} remaining`
    );

    return createSuccess({
      applied: changes,
      resolved,
      remaining,
    });
  } catch (error) {
    console.error(`[audit] Error applying fixes: ${error.message}`);
    return createError(error.message, {
      applied: [],
      resolved: [],
      remaining: strategies,
    });
  }
}

/**
 * High-level function to analyze a project for vulnerabilities
 * @param {string} projectPath - Absolute path to the project
 * @returns {Promise<Object>} { projectPath, vulnerabilities: array, strategies: array, summary: object }
 */
async function analyzeProject(projectPath, allowReset = false) {
  try {
    console.log(`[audit] Analyzing project: ${projectPath} (allowReset: ${allowReset})`);

    // Step 0: Git reset and pull if allowReset is enabled
    if (allowReset) {
      console.log('[audit] Step 0: Resetting and pulling repository...');
      try {
        const gitResult = await git.prepareRepository(projectPath, allowReset);
        if (gitResult.success) {
          console.log(
            `[audit] Repository reset and pulled successfully (branch: ${gitResult.branch})`
          );
        } else {
          console.warn(`[audit] Git preparation failed: ${gitResult.error}`);
          console.warn('[audit] Continuing with scan despite git failure...');
        }
      } catch (gitError) {
        console.error(`[audit] Git operation error: ${gitError.message}`);
        console.warn('[audit] Continuing with scan despite git error...');
      }
    }

    // Step 1: Run npm install
    console.log('[audit] Step 1: Running npm install...');
    const installResult = await runNpmInstall(projectPath);
    if (!installResult.success) {
      console.warn(`[audit] npm install had issues: ${installResult.error}`);
    }

    // Step 2: Run npm audit
    console.log('[audit] Step 2: Running npm audit...');
    const auditResult = await runNpmAudit(projectPath);
    if (!auditResult.success) {
      return createError(auditResult.error || 'npm audit failed', {
        projectPath,
        vulnerabilities: [],
        strategies: [],
        summary: {
          total: 0,
          critical: 0,
          high: 0,
          moderate: 0,
          low: 0,
          fixable: 0,
        },
      });
    }

    // Step 3: Parse vulnerabilities
    console.log('[audit] Step 3: Parsing vulnerabilities...');
    const vulnerabilities = await parseVulnerabilities(auditResult.content.auditData, projectPath);

    if (vulnerabilities.length === 0) {
      console.log('[audit] No vulnerabilities found!');
      return createSuccess({
        projectPath,
        vulnerabilities: [],
        strategies: [],
        summary: {
          total: 0,
          critical: 0,
          high: 0,
          moderate: 0,
          low: 0,
          fixable: 0,
        },
      });
    }

    // Step 4: Determine fix strategies
    console.log('[audit] Step 4: Determining fix strategies...');
    const strategies = [];
    for (let i = 0; i < vulnerabilities.length; i++) {
      const strategy = await determineFixStrategy(
        vulnerabilities[i],
        auditResult.content.auditData
      );
      strategies.push(strategy);
    }

    // Step 5: Generate summary
    const summary = {
      total: vulnerabilities.length,
      critical: vulnerabilities.filter((v) => v.severity === 'critical').length,
      high: vulnerabilities.filter((v) => v.severity === 'high').length,
      moderate: vulnerabilities.filter((v) => v.severity === 'moderate').length,
      low: vulnerabilities.filter((v) => v.severity === 'low').length,
      fixable: strategies.filter((s) => s.type !== 'NO_FIX').length,
      directDependencies: vulnerabilities.filter((v) => v.isDirect).length,
      transientDependencies: vulnerabilities.filter((v) => !v.isDirect).length,
      strategies: {
        updateDirect: strategies.filter((s) => s.type === 'UPDATE_DIRECT').length,
        updateParent: strategies.filter((s) => s.type === 'UPDATE_PARENT').length,
        addOverride: strategies.filter((s) => s.type === 'ADD_OVERRIDE').length,
        noFix: strategies.filter((s) => s.type === 'NO_FIX').length,
      },
    };

    console.log('[audit] Analysis complete:', summary);

    return createSuccess({
      projectPath,
      vulnerabilities,
      strategies,
      summary,
    });
  } catch (error) {
    console.error(`[audit] Error analyzing project: ${error.message}`);
    return createError(error.message, {
      projectPath,
      vulnerabilities: [],
      strategies: [],
      summary: {
        total: 0,
        critical: 0,
        high: 0,
        moderate: 0,
        low: 0,
        fixable: 0,
      },
    });
  }
}

/**
 * Clear the registry cache
 * Should be called ONCE at the start of a scan session (when user clicks "Scan"),
 * NOT per-project. This ensures fresh data for each scan while preserving cache
 * hits across all projects within the same session.
 */
function clearCache() {
  registryCache.clear();
}

// Export all functions
module.exports = {
  runNpmInstall,
  runNpmAudit,
  parseVulnerabilities,
  determineFixStrategy,
  determineSafeVersion,
  fetchLatestSafeVersion,
  fetchAllVersions,
  getInstalledVersionFromLockfile,
  findSafeVersionOutsideRange,
  findParentPackage,
  generatePackageJsonChanges,
  applyFixes,
  analyzeProject,
  clearCache,
};
